# 只想先跑起来并预览站点：你只需要填写这一行
OPENAI_API_KEY=sk-proj-your-openai-api-key

# 可选：不填时默认走 OpenAI，并默认使用 gpt-5.4
LLM_PROVIDER=
OPENAI_MODEL=
OPENAI_BASE_URL=

# DeepSeek 配置（如果要切回 DeepSeek 再填写）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=

# 可选：站点名称（不填默认 VideoBrief）
SITE_NAME=

# 可选：预览时可留空；正式上线前一定要改成你自己的随机字符串
JWT_SECRET=

# 可选：留空时默认允许所有来源；正式上线后再收紧
CORS_ALLOW_ORIGINS=

# Stripe 支付配置（如果只是先预览站点，可以暂时留空）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
VIP_MONTHLY_PRICE_CENTS=
VIP_CURRENCY=

# 可选：支付回跳地址；不做支付可留空
FRONTEND_URL=
