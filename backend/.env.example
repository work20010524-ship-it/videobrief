# 只想先跑起来并预览站点：你只需要填写这一行
OPENAI_API_KEY=sk-proj-your-openai-api-key

# 可选：不填时默认走 OpenAI，并默认使用 gpt-5.4
LLM_PROVIDER=
OPENAI_MODEL=
OPENAI_BASE_URL=

# DeepSeek 配置（如果要切回 DeepSeek 再填写）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=

# 可选：站点名称（不填默认 VideoBrief）
SITE_NAME=

# 可选：预览时可留空；正式上线前一定要改成你自己的随机字符串
JWT_SECRET=

# 可选：留空时默认允许所有来源；正式上线后再收紧
CORS_ALLOW_ORIGINS=

# 可选：yt-dlp 网络配置。B 站如果返回 412，系统会先尝试公开 API 兜底；仍失败时再填代理或 cookie
YTDLP_PROXY=
YTDLP_COOKIEFILE=
YTDLP_USER_AGENT=
# 可选：B 站 cookie。填这一行后，B 站解析、下载、字幕/AI 总结都会自动带上
# 格式类似：SESSDATA=...; bili_jct=...; DedeUserID=...
BILIBILI_COOKIE=

# 可选：没有平台字幕时，自动用 OpenAI 语音转写做兜底
ENABLE_AUDIO_TRANSCRIPTION_FALLBACK=1
# 可选：字幕和语音转写都失败时，用公开视频标题/简介生成有限总结
ENABLE_METADATA_SUMMARY_FALLBACK=1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIPTION_MAX_FILE_MB=24
OPENAI_TRANSCRIPTION_MAX_DURATION_SECONDS=1800
# 可选：OpenAI 接口连接超时秒数；服务器网络慢时可调大
OPENAI_TIMEOUT_SECONDS=120
# 可选：如果服务器直连 OpenAI 不通，可配置出站代理；不需要代理时留空
HTTPS_PROXY=
HTTP_PROXY=

# Stripe 支付配置（如果只是先预览站点，可以暂时留空）
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
# 可选：留空时走 Stripe Dashboard 的动态支付方式；如需手动指定可填 card,alipay,wechat_pay
STRIPE_PAYMENT_METHOD_TYPES=

# 易支付兼容接口配置。把 PAYMENT_PROVIDER 改成 epay 后生效
EPAY_API_URL=
EPAY_PID=
EPAY_KEY=
EPAY_DEFAULT_TYPE=alipay
EPAY_ALIPAY_TYPE=alipay
EPAY_WXPAY_TYPE=wxpay
PUBLIC_BASE_URL=

VIP_MONTHLY_PRICE_CENTS=
VIP_CURRENCY=

# 可选：支付回跳地址；不做支付可留空
FRONTEND_URL=
